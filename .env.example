# ------------------------------------------------------------------
# cv-for-kreatif — server environment (placeholders only).
# Copy this file to `.env.local` for local development and fill in the
# real values. NEVER commit real credentials; `.env*` is git-ignored.
# ------------------------------------------------------------------

# --- Authentication (Auth.js / NextAuth v5) -------------------------
# GitHub OAuth App: https://github.com/settings/developers
# Generate with:  npx auth secret   (or `openssl rand -base64 32`)
AUTH_SECRET=generate-a-random-secret
# GitHub OAuth App client id / secret (NOT prefixed with NEXT_PUBLIC_).
AUTH_GITHUB_ID=your-github-oauth-client-id
AUTH_GITHUB_SECRET=your-github-oauth-client-secret

# Base URL used to build OAuth callback URLs.
# Local:   http://localhost:3000
# Vercel:  https://cv-for-creative.vercel.app  (or AUTH_TRUST_HOST=true)
AUTH_URL=http://localhost:3000
# Required when relying on Vercel/HOST headers to infer the URL in prod.
AUTH_TRUST_HOST=true

# GitHub account ID (numeric) that is allowed to edit & publish.
# Do NOT use a username. See README for how to find it.
CV_ADMIN_ID=12345678

# --- GitHub contents API (server-side writes) -----------------------
# Fine-grained PAT with "Contents: Read and write" on ONLY this repo.
# https://github.com/settings/tokens?type=beta
GH_PAT=github_fine_grained_token_here
GH_REPO_OWNER=AfifAmirudin
GH_REPO_NAME=cv-for-creative
# Production branch that Vercel deploys from (never change at runtime).
GH_BRANCH=main
# Path inside the repo that holds the CV content (source of truth).
GH_CONTENT_PATH=data/cv.json

# --- Optional cross-site request allowlist (CSRF) --------------------
# Comma-separated list of additional origins allowed to call the
# dashboard write endpoints. Usually unnecessary: same-origin requests
# and the values derived from AUTH_URL / VERCEL_URL are allowed already.
#ALLOWED_ORIGINS=https://example.com

# --- Optional Vercel deployment verification ------------------------
# Without these, the dashboard reports "saved to GitHub — publication
# not verified" instead of polling deployment status.
# Vercel token with read access: https://vercel.com/account/tokens
#VERCEL_API_TOKEN=your_vercel_api_token
#VERCEL_PROJECT_ID=prj_xxxxxxxxxxxxxxxxxxxx